{
	"projectName": "SCCharts",
	"languages": [
		{
			"id": "sccharts",
			"grammar": "src/grammar/scchart.langium",
			"fileExtensions": [".scchart"],
			"textMate": {
				"out": "syntaxes/domain-model.tmLanguage.json"
			},
			"railroad": {
				"out": "docs/syntax-diagram.html"
			}
		}
	],
	"out": "src/grammar/generated",
	"chevrotainParserConfig": {
		"recoveryEnabled": true,
		"nodeLocationTracking": "full",
		"maxLookahead": 3
	}
}
