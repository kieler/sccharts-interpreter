{
  "name": "sccharts",
  "scopeName": "source.sccharts",
  "fileTypes": [
    ".scchart"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "name": "keyword.control.sccharts",
      "match": "\\b(abort|connector|do|during|entry|exit|final|go|history|if|immediate|initial|input|join|output|region|scchart|state|to)\\b"
    },
    {
      "name": "string.quoted.double.sccharts",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "include": "#string-character-escape"
        }
      ]
    },
    {
      "name": "string.quoted.single.sccharts",
      "begin": "'",
      "end": "'",
      "patterns": [
        {
          "include": "#string-character-escape"
        }
      ]
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.sccharts",
          "begin": "/\\*",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.sccharts"
            }
          },
          "end": "\\*/",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.sccharts"
            }
          }
        },
        {
          "begin": "//",
          "beginCaptures": {
            "1": {
              "name": "punctuation.whitespace.comment.leading.sccharts"
            }
          },
          "end": "(?=$)",
          "name": "comment.line.sccharts"
        }
      ]
    },
    "string-character-escape": {
      "name": "constant.character.escape.sccharts",
      "match": "\\\\(x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4}|u\\{[0-9A-Fa-f]+\\}|[0-2][0-7]{0,2}|3[0-6][0-7]?|37[0-7]?|[4-7][0-7]?|.|$)"
    }
  }
}
