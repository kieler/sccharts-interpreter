{
  "name": "sccharts",
  "scopeName": "source.sccharts",
  "fileTypes": [
    ".scchart"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "name": "keyword.control.sccharts",
      "match": "\\b(abort|connector|do|during|entry|exit|final|go|if|immediate|initial|input|join|output|region|scchart|state|to)\\b"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.sccharts",
          "begin": "/\\*",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.sccharts"
            }
          },
          "end": "\\*/",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.sccharts"
            }
          }
        },
        {
          "begin": "//",
          "beginCaptures": {
            "1": {
              "name": "punctuation.whitespace.comment.leading.sccharts"
            }
          },
          "end": "(?=$)",
          "name": "comment.line.sccharts"
        }
      ]
    }
  }
}
