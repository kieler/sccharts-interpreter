		"express": "^5.2.1"
	},
	"devDependencies": {
		"@types/express": "^5.0.6",
		"@types/node": "^22.20.0",
		"concurrently": "^10.0.3",
		"typescript": "^5.6.0",
		"vite": "^7.3.6",
		"vitest": "^3.0.0",
		"wait-on": "^9.0.10"
	}
