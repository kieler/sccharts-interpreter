scchart ABO {
  input bool A, B
  output bool O1, O2

  initial state EntryInit
  immediate do O1 = false; O2 = false go to WaitAB


  state WaitAB {
    region HandleB {
      initial state WaitB
      if B do O1 = true go to DoneB

      final state DoneB
    }
    region HandleA {
      initial state WaitA
      if A do B = true; O1 = true go to DoneA

      final state DoneA
    }
  }
  do O1 = false; O2 = true join to GotAB

  final state GotAB
}
